<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FlixelDebugger.App</RootNamespace>
    <AssemblyName>FlixelDebugger.App</AssemblyName>
    <Description>The FlixelGDX debugger desktop app: a window with dockable panels on top of FlixelDebugger.Core.</Description>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlixelDebugger.Core\FlixelDebugger.Core.csproj" />
    <ProjectReference Include="..\FlixelDebugger.Protocol\FlixelDebugger.Protocol.csproj" />
  </ItemGroup>

</Project>
