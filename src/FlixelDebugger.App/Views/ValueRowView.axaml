<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlixelDebugger.App.ViewModels"
             x:Class="FlixelDebugger.App.Views.ValueRowView"
             x:DataType="vm:ValueRowViewModel">
  <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8" Margin="0,1">
    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}"
               Classes.good="{Binding IsGood}" Classes.warn="{Binding IsWarning}" Classes.error="{Binding IsError}" />
  </Grid>
</UserControl>
