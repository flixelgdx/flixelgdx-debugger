<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:FlixelDebugger.App.Panels"
             x:Class="FlixelDebugger.App.Views.PlaceholderPanelView"
             x:DataType="panels:PlaceholderPanelViewModel">
  <TextBlock Text="{Binding Description}" Margin="12" TextWrapping="Wrap"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Foreground="{DynamicResource MutedTextBrush}" />
</UserControl>
