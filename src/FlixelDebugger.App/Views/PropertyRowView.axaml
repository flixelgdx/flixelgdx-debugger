<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlixelDebugger.App.ViewModels"
             x:Class="FlixelDebugger.App.Views.PropertyRowView"
             x:DataType="vm:PropertyRowViewModel">
  <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8" Margin="0,1">
    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
               ToolTip.Tip="{Binding Name}" />
    <Panel Grid.Column="1">
      <CheckBox IsVisible="{Binding IsBoolEditor}"
                IsChecked="{Binding BoolValue, Mode=TwoWay}"
                MinHeight="0" />
      <TextBox x:Name="Editor"
               IsVisible="{Binding IsTextEditor}"
               Text="{Binding EditText, Mode=TwoWay}"
               Classes.invalid="{Binding HasInputError}"
               MinHeight="0"
               Padding="6,3"
               FontFamily="{StaticResource MonoFont}" />
      <TextBlock Classes="value" IsVisible="{Binding IsPlainText}" Text="{Binding DisplayText}"
                 VerticalAlignment="Center" />
      <TextBlock Classes="value error" IsVisible="{Binding IsError}" Text="{Binding DisplayText}"
                 VerticalAlignment="Center" />
    </Panel>
  </Grid>
</UserControl>
