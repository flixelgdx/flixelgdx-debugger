<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlixelDebugger.App.ViewModels"
             x:Class="FlixelDebugger.App.Views.ConsolePanelView"
             x:DataType="vm:ConsolePanelViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="8" RowSpacing="6">
    <TextBlock Grid.Row="0" Text="{x:Static vm:ConsolePanelViewModel.HintText}" Foreground="{DynamicResource MutedTextBrush}" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
      <TextBox x:Name="Input" Grid.Column="0" Text="{Binding Text}"
               FontFamily="{StaticResource MonoFont}" AcceptsTab="False" AcceptsReturn="False"
               Watermark="Command" />
      <Button Grid.Column="1" Content="Run" Command="{Binding RunCommand}" />
    </Grid>

    <TextBlock x:Name="SuggestionText" Grid.Row="2" FontFamily="{StaticResource MonoFont}"
               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MinHeight="18" />
  </Grid>
</UserControl>
