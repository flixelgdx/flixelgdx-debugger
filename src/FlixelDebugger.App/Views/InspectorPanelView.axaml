<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlixelDebugger.App.ViewModels"
             xmlns:conv="using:FlixelDebugger.App.Converters"
             x:Class="FlixelDebugger.App.Views.InspectorPanelView"
             x:DataType="vm:InspectorPanelViewModel">
  <DockPanel Margin="8,6">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
      <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSelection}"
                 Text="{x:Static vm:InspectorPanelViewModel.EmptyHint}" />
      <Border IsVisible="{Binding IsAgentSelection}"
              HorizontalAlignment="Left"
              CornerRadius="3"
              Padding="6,1"
              Background="{DynamicResource AgentBrush}">
        <TextBlock Text="An AI agent selected this object"
                   FontSize="11"
                   Foreground="White" />
      </Border>
      <Grid ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="4"
            IsVisible="{Binding HasSelection}">
        <TextBox IsReadOnly="True"
                 Text="{Binding Path, Mode=OneWay}"
                 FontFamily="{StaticResource MonoFont}"
                 MinHeight="0"
                 Padding="6,3" />
        <Button Grid.Column="1"
                Classes="compact"
                Content="Parent"
                Command="{Binding SelectParentCommand}" />
        <Button Grid.Column="2" Classes="compact" Content="Go to" Command="{Binding GoToCommand}" />
        <Button Grid.Column="3"
                Classes="compact"
                Content="Clear"
                Command="{Binding ClearCommand}" />
      </Grid>
      <TextBox Text="{Binding PathEntry, Mode=TwoWay}"
               PlaceholderText="Select by path (for example state.3.0) and press Enter"
               FontFamily="{StaticResource MonoFont}"
               MinHeight="0"
               Padding="6,3">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SelectPathCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </StackPanel>

    <ScrollViewer IsVisible="{Binding HasSelection}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InspectorSectionViewModel">
              <Expander Header="{Binding DisplayName}"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding Grid.Rows}" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Preview"
                  IsVisible="{Binding HasTexture}"
                  IsExpanded="{Binding PreviewExpanded, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,0,0,4">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Zoom" VerticalAlignment="Center" />
              <Slider Grid.Column="1"
                      Minimum="0.5"
                      Maximum="4"
                      TickFrequency="0.25"
                      SmallChange="0.25"
                      LargeChange="0.5"
                      IsSnapToTickEnabled="True"
                      Value="{Binding Preview.Zoom, Mode=TwoWay}" />
              <Button Grid.Column="2"
                      Classes="compact"
                      Content="Refresh"
                      Command="{Binding RefreshPreviewCommand}" />
            </Grid>
            <TextBlock Classes="muted" Text="{Binding Preview.Status}" TextWrapping="Wrap" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          MaxHeight="320"
                          IsVisible="{Binding Preview.HasImage}">
              <Image Source="{Binding Preview.Image,
                                      Converter={x:Static conv:PngImageConverter.Instance}}"
                     Width="{Binding Preview.DisplayWidth}"
                     Height="{Binding Preview.DisplayHeight}"
                     Stretch="Fill"
                     HorizontalAlignment="Left"
                     RenderOptions.BitmapInterpolationMode="None" />
            </ScrollViewer>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
