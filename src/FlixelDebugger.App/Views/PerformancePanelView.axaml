<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlixelDebugger.App.ViewModels"
             xmlns:ctl="using:FlixelDebugger.App.Controls"
             x:Class="FlixelDebugger.App.Views.PerformancePanelView"
             x:DataType="vm:PerformancePanelViewModel">
  <DockPanel Margin="10,6">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
      <TextBlock Text="Sample rate" />
      <TextBlock Grid.Column="1" Classes="value" Text="{Binding SampleRateText}" />
      <TextBlock Grid.Row="1" Text="Listening on" />
      <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ListenAddress}" />
    </Grid>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PerformanceSectionViewModel">
            <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
              <ItemsControl ItemsSource="{Binding Graphs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GraphViewModel">
                    <StackPanel Margin="0,0,0,8" Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding LatestText}" />
                      </Grid>
                      <ctl:GraphControl Graph="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
