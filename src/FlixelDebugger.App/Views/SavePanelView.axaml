<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlixelDebugger.App.ViewModels"
             x:Class="FlixelDebugger.App.Views.SavePanelView"
             x:DataType="vm:SavePanelViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8,6">
    <!-- The save picker only shows when the game keeps more than one save. The rows below use
         margins instead of row spacing, so the hidden picker leaves no gap. -->
    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="8"
          Margin="0,0,0,6"
          IsVisible="{Binding HasManySaves}">
      <TextBlock Text="Save" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Saves}"
                SelectedIndex="{Binding SelectedSaveIndex, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                MinHeight="0"
                ToolTip.Tip="The save this panel shows and edits">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SaveChoiceViewModel">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <TextBlock Grid.Row="1"
               Classes="value"
               Text="{Binding Status}"
               Classes.error="{Binding IsError}"
               Margin="0,0,0,6" />
    <TextBox Grid.Row="2"
             Margin="0,0,0,6"
             Text="{Binding Filter, Mode=TwoWay}"
             PlaceholderText="Filter keys"
             MinHeight="0"
             Padding="6,3" />

    <Grid Grid.Row="3" ColumnDefinitions="2*,3*" ColumnSpacing="8" Margin="0,0,0,6">
      <TextBlock Classes="heading" Text="Path" Margin="6,0" />
      <TextBlock Grid.Column="1" Classes="heading" Text="Value" />
    </Grid>

    <ListBox Grid.Row="4"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SaveRowViewModel">
          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8" Margin="6,2">
            <TextBlock Classes="value"
                       Text="{Binding Label}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Path}" />
            <TextBlock Grid.Column="1"
                       Classes="value"
                       Text="{Binding Display}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Classes.muted="{Binding IsRemoved}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="5" Spacing="6" Margin="0,6,0,0">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
        <TextBlock Text="Path" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding PathText, Mode=TwoWay}"
                 FontFamily="{StaticResource MonoFont}"
                 MinHeight="0"
                 Padding="6,3" />
        <TextBlock Grid.Row="1" Text="Value" VerticalAlignment="Center" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding ValueText, Mode=TwoWay}"
                 FontFamily="{StaticResource MonoFont}"
                 MinHeight="0"
                 Padding="6,3" />
      </Grid>
      <WrapPanel>
        <Button Content="Set" Command="{Binding SetCommand}" Margin="0,0,6,4" />
        <Button Content="Reset key" Command="{Binding ResetKeyCommand}" Margin="0,0,6,4" />
        <Button Content="Save now" Command="{Binding SaveNowCommand}" Margin="0,0,6,4" />
        <Button Content="{Binding ResetAllText}" Command="{Binding ResetAllCommand}"
                Classes.active="{Binding IsResetAllArmed}" Margin="0,0,6,4" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
